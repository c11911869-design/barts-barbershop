---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import SectionHeading from '../components/SectionHeading.astro';
import LocalBusinessJsonLd from '../components/LocalBusinessJsonLd.astro';
import { business } from '../data/business';

const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);
const renderedServices = await Promise.all(
  services.map(async (service) => ({
    ...service,
    Content: (await render(service)).Content,
  })),
);
---

<BaseLayout
  title="Services"
  description="Explore haircuts, fades, shaves, beard trims, color, perms, and full-service barbering from Bart's Barber Shop, with more than 60 years in the hair industry."
  path="/services/"
>
  <LocalBusinessJsonLd services={services.map((service) => service.data.title)} pagePath="/services/" />
  <section class="bg-paper py-16">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
      <SectionHeading eyebrow="Services" title="Full-service barbering" description="Bart's offers haircuts and grooming for men, women, and children. Call for current pricing and service availability." />
      <div class="mt-8 grid gap-6 text-coal md:grid-cols-2">
        <div class="space-y-4 leading-8">
          <p>
            See Bart Jr. or Laura for services at the barber shop. Bart's has eight barber chairs and friendly, professional, courteous staff members ready to help with all types of men's and women's haircuts.
          </p>
          <p>
            For children, Bart's also specializes in first haircuts. The shop takes pride in a clean, professional, and friendly atmosphere with hardly ever a long wait for a haircut.
          </p>
        </div>
        <div class="space-y-4 leading-8">
          <p>
            The Hair House offers men's and women's haircuts, styling, coloring, perms, and personal hair services with Bart Jr., Laura, and the professional shop staff.
          </p>
          <p>
            Bart's also keeps the tradition of the old-fashioned hot towel lathered face shave, a lost art you can still find here at reasonable prices.
          </p>
        </div>
      </div>
      <div class="mt-10 grid gap-5 md:grid-cols-2">
        {renderedServices.map((service) => {
          const Content = service.Content;
          return (
            <article class="rounded-md border border-razor bg-white p-6">
              <div class="flex flex-wrap items-start justify-between gap-4">
                <div>
                  <h2 class="font-serif text-3xl font-bold">{service.data.title}</h2>
                  <p class="mt-3 text-coal">{service.data.description}</p>
                </div>
                <a
                  href={business.phoneHref}
                  aria-label={`Call ${business.name} for current pricing for ${service.data.title}`}
                  class="rounded-md bg-brass px-3 py-2 text-sm font-bold text-paper transition hover:bg-brass-dark"
                >
                  {service.data.price}
                </a>
              </div>
              <p class="mt-4 text-sm font-semibold uppercase tracking-[0.14em] text-coal">{service.data.duration}</p>
              <div class="prose-content mt-4 text-sm"><Content /></div>
            </article>
          );
        })}
      </div>
      <div class="mt-10 flex flex-wrap gap-3">
        <Button href={business.phoneHref}>Call Now</Button>
        <Button href={business.directionsUrl} variant="ghost">Get Directions</Button>
      </div>
    </div>
  </section>
</BaseLayout>
