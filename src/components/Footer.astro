---
import { business } from '../data/business';
---

<footer class="bg-ink text-paper">
  <div class="mx-auto grid max-w-6xl gap-8 px-4 py-10 sm:px-6 md:grid-cols-2 lg:grid-cols-[1.2fr_1fr_1fr_1.1fr] lg:px-8">
    <div>
      <p class="font-serif text-3xl font-bold">{business.name}</p>
      <p class="mt-3 max-w-md text-sm leading-7 text-razor">
        Family-owned Laurel barber shop with classic cuts, walk-in service, and more than 60 years in the hair industry.
      </p>
    </div>
    <div>
      <h2 class="text-sm font-bold uppercase tracking-[0.16em] text-brass">Visit</h2>
      <address class="mt-3 not-italic text-sm leading-7 text-razor">
        {business.locationName}<br />
        {business.address.streetAddress}<br />
        {business.address.addressLocality}, {business.address.addressRegion} {business.address.postalCode}
      </address>
    </div>
    <div>
      <h2 class="text-sm font-bold uppercase tracking-[0.16em] text-brass">Contact</h2>
      <p class="mt-3 text-sm leading-7 text-razor">
        <a class="hover:text-paper" href={business.phoneHref}>{business.phoneDisplay}</a><br />
        <a class="hover:text-paper" href={business.directionsUrl}>Get Directions</a>
      </p>
    </div>
    <div>
      <h2 class="text-sm font-bold uppercase tracking-[0.16em] text-brass">Hours</h2>
      <dl class="mt-3 grid gap-2 text-sm text-razor">
        {business.displayHours.map((hours) => (
          <div class="flex justify-between gap-4 border-b border-white/10 pb-2">
            <dt>{hours.dayOfWeek}</dt>
            <dd class="font-semibold text-paper">{hours.hours}</dd>
          </div>
        ))}
      </dl>
    </div>
  </div>
  <div class="border-t border-white/10 px-4 py-5 text-center text-xs text-razor">
    &copy; {new Date().getFullYear()} {business.name}. All rights reserved.
  </div>
</footer>
