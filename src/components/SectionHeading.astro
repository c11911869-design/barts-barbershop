---
interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
}

const { eyebrow, title, description } = Astro.props;
---

<div class="max-w-3xl">
  {eyebrow && <p class="text-sm font-bold uppercase tracking-[0.18em] text-clay">{eyebrow}</p>}
  <h1 class="mt-3 font-serif text-4xl font-bold leading-tight text-ink sm:text-5xl">{title}</h1>
  {description && <p class="mt-4 text-lg leading-8 text-coal">{description}</p>}
</div>
