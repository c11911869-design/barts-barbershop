# Local development for the Cloudflare Pages Function.
# Copy to `.dev.vars` (gitignored) and fill in. Never commit real values.

# Public: safe to expose in the built HTML. Falls back to Cloudflare's
# "always passes" test key when unset.
PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# Secret: Turnstile dashboard -> your widget -> Secret Key.
# 1x0000000000000000000000000000000AA is Cloudflare's always-passes test secret.
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Fine-grained GitHub PAT, Issues: Read and write, scoped to this repo only.
FEEDBACK_GITHUB_TOKEN=
FEEDBACK_GITHUB_REPO=c11911869-design/barts-barbershop

# Resend API key and addresses for the notification email.
RESEND_API_KEY=
FEEDBACK_TO_EMAIL=you@example.com
FEEDBACK_FROM_EMAIL=onboarding@resend.dev

# Optional shared access code. If set, the form requires it and the page must
# render a matching `passcode` input. Leave empty to accept open submissions.
FEEDBACK_PASSCODE=
